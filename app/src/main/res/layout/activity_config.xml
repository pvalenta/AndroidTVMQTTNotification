<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background"
    android:padding="32dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/tv_text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Overlay permission status -->
    <TextView
        android:id="@+id/tv_overlay_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Checking overlay permission…"
        android:textColor="@color/tv_text_secondary"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/btn_grant_overlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_grant_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/grant_overlay"
        android:textSize="14sp"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        android:layout_marginTop="4dp" />

    <!-- Divider -->
    <View
        android:id="@+id/divider1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/tv_divider"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_overlay_status" />

    <!-- Left column: Broker settings -->
    <TextView
        android:id="@+id/lbl_host"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/broker_host"
        android:textColor="@color/tv_text_secondary"
        android:textSize="16sp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider1" />

    <EditText
        android:id="@+id/et_broker_host"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_broker_host"
        android:inputType="textUri"
        android:textColor="@color/tv_text_primary"
        android:textColorHint="@color/tv_text_secondary"
        android:textSize="18sp"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:focusable="true"
        android:nextFocusDown="@id/et_broker_port"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/gl_center"
        app:layout_constraintTop_toBottomOf="@id/lbl_host"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/lbl_port"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/broker_port"
        android:textColor="@color/tv_text_secondary"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_broker_host" />

    <EditText
        android:id="@+id/et_broker_port"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="1883"
        android:inputType="number"
        android:textColor="@color/tv_text_primary"
        android:textColorHint="@color/tv_text_secondary"
        android:textSize="18sp"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:focusable="true"
        android:nextFocusDown="@id/et_username"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/gl_center"
        app:layout_constraintTop_toBottomOf="@id/lbl_port"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/lbl_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/username"
        android:textColor="@color/tv_text_secondary"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_broker_port" />

    <EditText
        android:id="@+id/et_username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_username"
        android:inputType="textNoSuggestions"
        android:textColor="@color/tv_text_primary"
        android:textColorHint="@color/tv_text_secondary"
        android:textSize="18sp"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:focusable="true"
        android:nextFocusDown="@id/et_password"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/gl_center"
        app:layout_constraintTop_toBottomOf="@id/lbl_username"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/lbl_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/password"
        android:textColor="@color/tv_text_secondary"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_username" />

    <EditText
        android:id="@+id/et_password"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_password"
        android:inputType="textPassword"
        android:textColor="@color/tv_text_primary"
        android:textColorHint="@color/tv_text_secondary"
        android:textSize="18sp"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:focusable="true"
        android:nextFocusDown="@id/btn_discover_brokers"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/gl_center"
        app:layout_constraintTop_toBottomOf="@id/lbl_password"
        android:layout_marginEnd="16dp" />

    <Button
        android:id="@+id/btn_discover_brokers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/discover_brokers"
        android:focusable="true"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/gl_center"
        app:layout_constraintTop_toBottomOf="@id/et_password"
        android:layout_marginEnd="16dp" />

    <!-- Guideline center -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Right column: Topic settings -->
    <TextView
        android:id="@+id/lbl_topic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/topic"
        android:textColor="@color/tv_text_secondary"
        android:textSize="16sp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toEndOf="@id/gl_center"
        app:layout_constraintTop_toBottomOf="@id/divider1" />

    <EditText
        android:id="@+id/et_topic"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_topic"
        android:inputType="text"
        android:textColor="@color/tv_text_primary"
        android:textColorHint="@color/tv_text_secondary"
        android:textSize="18sp"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:focusable="true"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toEndOf="@id/gl_center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lbl_topic"
        android:layout_marginStart="16dp" />

    <CheckBox
        android:id="@+id/cb_auto_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_start"
        android:textColor="@color/tv_text_primary"
        android:textSize="16sp"
        android:buttonTint="@color/accent"
        android:focusable="true"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toEndOf="@id/gl_center"
        app:layout_constraintTop_toBottomOf="@id/et_topic"
        android:layout_marginStart="16dp" />

    <Button
        android:id="@+id/btn_scan_topics"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/scan_topics"
        android:focusable="true"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toEndOf="@id/gl_center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cb_auto_start"
        android:layout_marginStart="16dp" />

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/divider2"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/tv_text_secondary"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@id/progress_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/divider2"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp" />

    <!-- Bottom divider -->
    <View
        android:id="@+id/divider2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/tv_divider"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_service_status" />

    <!-- Bottom row -->
    <TextView
        android:id="@+id/tv_service_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Service: Stopped"
        android:textColor="@color/tv_text_secondary"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_save_start"
        app:layout_constraintBottom_toBottomOf="parent" />

    <Button
        android:id="@+id/btn_save_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/save_connect"
        android:focusable="true"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
